<div class="markdown summary">{{{summary}}}</div>
<div class="markdown conceptual">{{{conceptual}}}</div>

<script>
  (function() {
    function relocateFootnotes() {
      const footnoteRefs = document.querySelectorAll('.footnote-ref');
      footnoteRefs.forEach(ref => {
        const href = ref.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const targetId = href.substring(1);
        const footnoteLi = document.getElementById(targetId);
        if (!footnoteLi) return;

        let refContainer = ref.closest('p') || ref;
        let nextSibling = refContainer.nextElementSibling;
        while (nextSibling && !/^H[1-6]$/i.test(nextSibling.tagName)) {
          refContainer = nextSibling;
          nextSibling = nextSibling.nextElementSibling;
        }

        let localFootnotes = refContainer.nextElementSibling;
        if (!localFootnotes || !localFootnotes.classList.contains('footnotes')) {
          localFootnotes = document.createElement('div');
          localFootnotes.className = 'footnotes';
          localFootnotes.innerHTML = '<hr><ol></ol>';
          refContainer.parentNode.insertBefore(localFootnotes, refContainer.nextSibling);
        }

        const ol = localFootnotes.querySelector('ol');
        if (ol && !ol.contains(footnoteLi)) {
          ol.appendChild(footnoteLi);
        }
      });

      document.querySelectorAll('.footnotes').forEach(container => {
        const ol = container.querySelector('ol');
        if (ol && ol.children.length === 0) {
          container.remove();
        }
      });
    }

    function formatAndSortEnumTables() {
      document.querySelectorAll('.enum-table').forEach(table => {
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.forEach(row => {
          const raw = row.getAttribute('data-raw-syntax') || '';
          const nameAttr = row.getAttribute('data-name') || '';
          const match = raw.match(/^(?:.*?\.)?([A-Za-z0-9_]+)\s*=\s*(-?\d+)/);
          let name = nameAttr;
          let val = null;
          if (match) {
            name = match[1];
            val = parseInt(match[2], 10);
          } else {
            const numMatch = raw.match(/-?\d+/);
            if (numMatch) val = parseInt(numMatch[0], 10);
          }

          if (val !== null) {
            row.setAttribute('data-enum-val', val);
            const valCell = row.querySelector('.enum-value');
            if (valCell) valCell.innerHTML = '<code>' + val + '</code>';
          }
          if (name) {
            const nameCell = row.querySelector('.enum-name');
            if (nameCell) nameCell.innerHTML = '<code>' + name + '</code>';
          }
        });

        rows.sort((a, b) => {
          const valA = parseInt(a.getAttribute('data-enum-val') || '0', 10);
          const valB = parseInt(b.getAttribute('data-enum-val') || '0', 10);
          return valA - valB;
        });

        rows.forEach(row => tbody.appendChild(row));
      });
    }

    function init() {
      relocateFootnotes();
      formatAndSortEnumTables();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{{#syntax.parameters.0}}
<h4 class="section">{{__global.parameters}}</h4>
<table class="table table-bordered table-condensed">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>
  <tbody>
{{/syntax.parameters.0}}
{{#syntax.parameters}}
  <tr>
    <td><code>{{{id}}}</code></td>
    <td>{{{type.specName.0.value}}}</td>
    <td>{{{description}}}</td>
  </tr>
{{/syntax.parameters}}
{{#syntax.parameters.0}}
  </tbody>
</table>
{{/syntax.parameters.0}}

{{#syntax.return}}
<h4 class="section">{{__global.returns}}</h4>
<table class="table table-bordered table-condensed">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/syntax.return}}

{{#syntax.typeParameters.0}}
<h4 class="section">{{__global.typeParameters}}</h4>
<dl class="parameters">
{{/syntax.typeParameters.0}}
{{#syntax.typeParameters}}
  <dt><code>{{{id}}}</code></dt>
  <dd>{{{description}}}</dd>
{{/syntax.typeParameters}}
{{#syntax.typeParameters.0}}
</dl>
{{/syntax.typeParameters.0}}

{{#inClass}}
{{#inheritance.0}}
<dl class="typelist inheritance">
  <dt>{{__global.inheritance}}</dt>
  <dd>
{{/inheritance.0}}
{{#inheritance}}
    <div>{{{specName.0.value}}}</div>
{{/inheritance}}
    <div><span class="xref">{{name.0.value}}</span></div>
{{#inheritance.0}}
  </dd>
</dl>
{{/inheritance.0}}
{{/inClass}}

{{#implements.0}}
<dl class="typelist implements">
  <dt>{{__global.implements}}</dt>
  <dd>
{{/implements.0}}
{{#implements}}
    <div>{{{specName.0.value}}}</div>
{{/implements}}
{{#implements.0}}
  </dd>
</dl>
{{/implements.0}}

{{#inClass}}
{{#derivedClasses.0}}
<dl class="typelist derived">
  <dt>{{__global.derived}}</dt>
  <dd>
{{/derivedClasses.0}}
{{#derivedClasses}}
    <div>{{{specName.0.value}}}</div>
{{/derivedClasses}}
{{#derivedClasses.0}}
  </dd>
</dl>
{{/derivedClasses.0}}
{{/inClass}}

{{#inheritedMembers.0}}
<dl class="typelist inheritedMembers">
  <dt>{{__global.inheritedMembers}}</dt>
  <dd>
{{/inheritedMembers.0}}
{{#inheritedMembers}}
  <div>
  {{#definition}}
    <xref uid="{{definition}}" text="{{nameWithType.0.value}}" alt="{{fullName.0.value}}"/>
  {{/definition}}
  {{^definition}}
    <xref uid="{{uid}}" text="{{nameWithType.0.value}}" alt="{{fullName.0.value}}"/>
  {{/definition}}
  </div>
{{/inheritedMembers}}
{{#inheritedMembers.0}}
</dl>
{{/inheritedMembers.0}}

{{#extensionMethods.0}}
<dl class="typelist extensionMethods">
  <dt>{{__global.extensionMethods}}</dt>
  <dd>
{{/extensionMethods.0}}
{{#extensionMethods}}
<div>
  {{#definition}}
    <xref uid="{{definition}}" altProperty="fullName" displayProperty="nameWithType"/>
  {{/definition}}
  {{^definition}}
    <xref uid="{{uid}}" altProperty="fullName" displayProperty="nameWithType"/>
  {{/definition}}
</div>
{{/extensionMethods}}
{{#extensionMethods.0}}
</dl>
{{/extensionMethods.0}}

{{#isEnum}}
{{#children}}
<table class="table table-bordered table-condensed enum-table">
  <thead>
    <tr>
      <th>Value</th>
      <th>Name</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
{{#children}}
    <tr id="{{id}}" data-raw-syntax="{{syntax.content.0.value}}" data-name="{{name.0.value}}">
      <td class="enum-value"><code>{{syntax.content.0.value}}</code></td>
      <td class="enum-name"><code>{{name.0.value}}</code></td>
      <td class="enum-description">{{#remarks}}{{{summary}}}{{{remarks}}}{{/remarks}}{{^remarks}}{{{summary}}}{{/remarks}}</td>
    </tr>
{{/children}}
  </tbody>
</table>
{{/children}}
{{/isEnum}}

{{#example.0}}
<h2 id="{{id}}_examples">{{__global.examples}}</h2>
{{/example.0}}
{{#example}}
{{{.}}}
{{/example}}

{{#remarks}}
<h2 id="{{id}}_remarks">{{__global.remarks}}</h2>
<div class="markdown level0 remarks">{{{remarks}}}</div>
{{/remarks}}
