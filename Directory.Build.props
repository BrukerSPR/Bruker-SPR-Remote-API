<Project>

  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <!-- Company information -->
  <PropertyGroup>
    <Company>Bruker Daltonics GmbH &amp; Co KG</Company>
    <Copyright>Copyright © $([System.DateTime]::UtcNow.ToString("yyyy")), Bruker Daltonics GmbH &amp; Co KG</Copyright>
  </PropertyGroup>

  <!-- General settings -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>true</WarningsAsErrors>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

</Project>
