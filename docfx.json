{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "BrukerSprRemoteAPI",
          "files": [
            "BrukerSprRemoteAPI.csproj"
          ]
        }
      ],
      "dest": "docfx-generated",
      "includePrivateMembers": false,
      "filter": "docfx-filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docfx-generated/**.yml",
          "toc.yml"
        ],
        "exclude": [
          "docfx-generated/BrukerSprRemoteAPI.yml",
          "docfx-generated/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "media/**"
        ]
      }
    ],
    "output": "docfx-documentation",
    "template": [
      "default",
      "modern",
      "docfx-template"
    ],
    "markdownEngineProperties": {
      "markdigExtensions": [
        "Footnotes"
      ]
    },
    "globalMetadata": {
      "_appName": "Bruker SPR Remote API",
      "_appTitle": "Bruker SPR Remote API Documentation",
      "_appLogoPath": "media/Logo_Bruker.svg",
      "_enableSearch": true,
      "pdf": true,
      "pdfFileName": "API_Doku.pdf",
      "pdfTocPage": false,
      "pdfFooterTemplate": "<div style=\"display:none\"></div>"
    }
  }
}
