{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "BrukerSprRemoteAPI",
          "files": [
            "BrukerSprRemoteAPI.csproj"
          ]
        },
      ],
      "dest": "docfx-generated",
      "includePrivateMembers": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docfx-generated/**.yml",
        ]
      },
    ],
    "resource": [
      {
        "files": [
          "media/**"
        ]
      }
    ],
    "output": "doxfx-documentation",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Bruker SPR Remote API",
      "_appTitle": "Bruker SPR Remote API Documentation",
      "_enableSearch": true,
      "pdf": true,
      "pdfFileName": "API_Doku.pdf",
      "pdfTocPage": false
    }
  }
}
